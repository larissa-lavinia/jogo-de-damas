<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />

	<Project>
		<Option title="Jogo-de-Damas" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />

		<Build>

			<!-- ================================================== -->
			<!-- DEBUG - WINDOWS                                   -->
			<!-- ================================================== -->

			<Target title="Debug">
				<Option output="bin/Debug/Jogo-de-Damas.exe" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />

				<Compiler>
					<Add option="-g" />
					<Add option="-std=gnu++17" />
				</Compiler>

				<Linker>
					<!-- WINDOWS -->
					<Add directory="config/raylib/lib/windows" />
					<Add library="raylib" />
					<Add library="opengl32" />
					<Add library="gdi32" />
					<Add library="winmm" />

					<!--
					==================================================
					LINUX - DESCOMENTE AO COMPILAR NO LINUX

					<Add directory="config/raylib/lib/linux" />
					<Add library="raylib" />
					<Add library="X11" />
					<Add library="pthread" />
					<Add library="dl" />
					<Add library="m" />
					<Add library="rt" />

					==================================================
					-->
				</Linker>
			</Target>


			<!-- ================================================== -->
			<!-- RELEASE - WINDOWS                                 -->
			<!-- ================================================== -->

			<Target title="Release">
				<Option output="bin/Release/Jogo-de-Damas.exe" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />

				<Compiler>
					<Add option="-O2" />
					<Add option="-std=gnu++17" />
				</Compiler>

				<Linker>
					<Add option="-s" />

					<!-- WINDOWS -->
					<Add directory="config/raylib/lib/windows" />
					<Add library="raylib" />
					<Add library="opengl32" />
					<Add library="gdi32" />
					<Add library="winmm" />

					<!--
					==================================================
					LINUX - DESCOMENTE AO COMPILAR NO LINUX

					<Add directory="config/raylib/lib/linux" />
					<Add library="raylib" />
					<Add library="X11" />
					<Add library="pthread" />
					<Add library="dl" />
					<Add library="m" />
					<Add library="rt" />

					==================================================
					-->
				</Linker>
			</Target>

		</Build>


		<!-- ================================================== -->
		<!-- CONFIGURAÇÕES GERAIS DO COMPILADOR                 -->
		<!-- ================================================== -->

		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
			<Add option="-std=gnu++17" />
			<Add directory="config/raylib/include" />
		</Compiler>


		<!-- ================================================== -->
		<!-- ARQUIVOS DO PROJETO                                -->
		<!-- ================================================== -->

		<Unit filename="main.cpp" />
		<Unit filename="usuario.cpp" />

		<Extensions />

	</Project>
</CodeBlocks_project_file>