<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
    <FileVersion major="1" minor="6" />

    <Project>
        <Option title="Jogo-de-Damas" />
        <Option pch_mode="2" />
        <Option compiler="gcc" />

        <Build>

            <Target title="Debug">
                <Option output="bin/Debug/Jogo-de-Damas" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj/Debug/" />
                <Option type="1" />
                <Option compiler="gcc" />

                <Compiler>
                    <Add option="-g" />
                    <Add option="-std=gnu++17" />
                </Compiler>
            </Target>

            <Target title="Release">
                <Option output="bin/Release/Jogo-de-Damas" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj/Release/" />
                <Option type="1" />
                <Option compiler="gcc" />

                <Compiler>
                    <Add option="-O2" />
                    <Add option="-std=gnu++17" />
                </Compiler>

                <Linker>
                    <Add option="-s" />
                </Linker>
            </Target>

        </Build>

        <!-- Configuração geral do compilador -->
        <Compiler>
            <Add option="-Wall" />
            <Add option="-fexceptions" />
            <Add option="-std=gnu++17" />

            <!-- Raylib dentro do projeto -->
            <Add directory="config/raylib/include" />
        </Compiler>

        <!-- Configuração geral do linker -->
        <Linker>

            <!-- Raylib compilado dentro do projeto -->
            <Add library="raylib" />
            <Add directory="config/raylib/lib/linux" />

            <!-- Dependências do Raylib no Linux -->
            <Add library="X11" />
            <Add library="pthread" />
            <Add library="dl" />
            <Add library="m" />
            <Add library="rt" />

        </Linker>

        <Unit filename="main.cpp" />

        <Extensions />

    </Project>
</CodeBlocks_project_file>