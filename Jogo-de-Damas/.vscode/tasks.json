{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build project",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-Wextra",
                "-g3",
                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\usuario.cpp",
                "${workspaceFolder}\\screen\\login.cpp",
                "${workspaceFolder}\\screen\\inicio.cpp",
                "${workspaceFolder}\\screen\\cadastro.cpp",
                "-o",
                "${workspaceFolder}\\output\\main.exe",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila todos os .cpp do projeto e linka com raylib (MSYS2 UCRT64)."
        }
    ],
    "version": "2.0.0"
}
